# Provider secrets are environment-only and never saved in run checkpoints.
OPENAI_API_KEY=replace-with-provider-key
# Optional provider base URL:
# OPENAI_API_BASE=https://api.openai.com/v1

DATA_DIR=./data
DATASETS_DIR=./data/datasets
ECOALIGN_EXECUTION_MODE=demo
ECOALIGN_NUM_SAMPLES=5
ECOALIGN_MAX_CONCURRENT=5
ECOALIGN_RPM=60
ECOALIGN_TPM=100000
# Live requires ECOALIGN_MAX_RUN_COST and ECOALIGN_PRICES (JSON model -> price).
# Prefer --config /path/to/run.json for nested models and prices.
# See docs/iteration-b-migration.md. Do not put credentials in that JSON.
